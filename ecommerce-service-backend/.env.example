# ============================================
# 电商业务后端 环境配置模板
# 使用方法：复制本文件为 .env 并填入真实值
#   cp .env.example .env
# ============================================

# MySQL 连接（Docker 容器映射到宿主机 63306 端口，见 docker/docker-compose.yml）
# 密码默认 123456，请按实际环境修改
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@127.0.0.1:63306/commerce?charset=utf8mb4

# 服务监听配置
APP_HOST=localhost
APP_PORT=18081

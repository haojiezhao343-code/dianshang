# ============================================
# 智能客服后端 环境配置模板
# 使用方法：复制本文件为 .env 并填入真实值
#   cp .env.example .env
# ============================================

# ---- LLM 配置（硅基流动 SiliconFlow）----
# 模型名需带厂商前缀（deepseek-ai/），在 https://siliconflow.cn 申请 API Key
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=sk-your-api-key-here

# ---- 电商业务后端地址（本服务依赖其查询订单/物流/商品）----
COMMERCE_API_BASE_URL=http://127.0.0.1:18081

# MySQL 连接（Docker 容器映射到宿主机 63306 端口，见 docker/docker-compose.yml）
# 注意：本服务使用 async 驱动 aiomysql
DATABASE_URL=mysql+aiomysql://root:YOUR_PASSWORD@127.0.0.1:63306/customer_service?charset=utf8mb4

# ---- 服务监听配置 ----
APP_HOST=127.0.0.1
APP_PORT=18082

# ---- 数字人（魔珐星云）----
# AppID/Secret 在 https://www.xingyun3d.com 控制台获取
# SDK 限制：仅 localhost/https 环境可用；官方文档 https://www.xingyun3d.com/developers/52-183
DIGITAL_HUMAN_APP_ID=your-app-id-here
DIGITAL_HUMAN_APP_SECRET=your-app-secret-here
DIGITAL_HUMAN_GATEWAY_SERVER=https://nebula-agent.xingyun3d.com/user/v1/ttsa/session
